# Rimuru settings. Copy to .env (which is gitignored) and fill in what you use.
#
# Which model does which job is NOT set here: click Models in the app, or edit
# config/models.toml (config/models.example.toml shows every option). With no
# models set up, Rimuru runs in demo mode and says so.

# --- API keys: only the providers you use -------------------------------------
# The Models button can save these for you. They never leave this computer
# except to go to their own provider.
KIMI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# A key for any other OpenAI-compatible server (provider "custom"):
# CUSTOM_API_KEY=

# --- Engine -------------------------------------------------------------------
RIMURU_MAX_WORKERS=6
# Requests in flight to one provider at once, across all sessions.
RIMURU_LLM_CONCURRENCY=4
RIMURU_HOST=127.0.0.1
RIMURU_PORT=8800
# Where clones run code: auto | docker | simulated | host
#   auto      the Docker sandbox when Docker is running, otherwise nothing runs
#   host      directly on this machine, UNSANDBOXED - only if you mean it
RIMURU_SHELL=auto
# Practice runs and team channels work here; each chat session has its own folder.
RIMURU_WORKSPACE=./data/practice
# Each chat session's own folder of files goes here.
RIMURU_SESSIONS=./data/sessions
# Demo mode on purpose (same as: python run.py --demo)
# RIMURU_DEMO=1
# Other names this app may be reached by, if you serve it beyond this computer:
# RIMURU_ALLOWED_HOSTS=
